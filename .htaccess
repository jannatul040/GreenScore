# ── Error pages ──────────────────────────────────────────────
ErrorDocument 404 /GreenScore/404.php
ErrorDocument 403 /GreenScore/403.php

# ── Security headers (backup for servers without PHP) ────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Hide server info ──────────────────────────────────────────
ServerSignature Off

# ── Block direct access to sensitive files ────────────────────
<FilesMatch "\.(sql|log|env|json|lock|phar)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Block access to includes folder directly ──────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteRule ^includes/(?!login_action\.php) - [F,L]
</IfModule>